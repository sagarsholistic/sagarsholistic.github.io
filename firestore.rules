rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email));
    }

    // Page content collection
    // Public can read, only admins can write
    match /pageContent/{document} {
      allow read: if true;  // Public read access
      allow write: if isAdmin();  // Only admins can create/update/delete
    }

    // Reviews collection
    // Public can read published reviews
    // Admins have full access
    match /reviews/{reviewId} {
      // Public can only read published reviews
      allow read: if resource.data.isPublished == true || isAdmin();

      // Only admins can create, update, or delete
      allow create, update, delete: if isAdmin();
    }

    // Admin users collection
    // Only admins can read (to check if user is admin)
    // This collection should be manually managed via Firebase Console
    match /adminUsers/{email} {
      allow read: if isAdmin();
      allow write: if false;  // Managed manually via console
    }
  }
}
